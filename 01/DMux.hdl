// File name: projects/1/DMux.hdl
/**
 * Demultiplexor:
 * [a, b] = [in, 0] if sel = 0
 *          [0, in] if sel = 1
 */
CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    Nand(a=in, b=sel, out=boff);
    Nand(a=boff, b=boff, out=b);
    Nand(a=boff, b=in, out=aoff);
    Nand(a=aoff, b=aoff, out=a);
}